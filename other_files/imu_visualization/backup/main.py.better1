import numpy as np

# ================= 工具函数 =================

def normalize(v):
    return v / np.linalg.norm(v)

def quat_mul(q1, q2):
    w1, x1, y1, z1 = q1
    w2, x2, y2, z2 = q2
    return np.array([
        w1*w2 - x1*x2 - y1*y2 - z1*z2,
        w1*x2 + x1*w2 + y1*z2 - z1*y2,
        w1*y2 - x1*z2 + y1*w2 + z1*x2,
        w1*z2 + x1*y2 - y1*x2 + z1*w2
    ])

def quat_to_rotmat(q):
    w, x, y, z = q
    return np.array([
        [1-2*(y*y+z*z), 2*(x*y-z*w),   2*(x*z+y*w)],
        [2*(x*y+z*w),   1-2*(x*x+z*z), 2*(y*z-x*w)],
        [2*(x*z-y*w),   2*(y*z+x*w),   1-2*(x*x+y*y)]
    ])

def quat_to_euler(q):
    w, x, y, z = q
    yaw = np.arctan2(2*(w*z + x*y), 1 - 2*(y*y + z*z))
    pitch = np.arcsin(2*(w*x - y*z))
    roll = np.arctan2(2*(w*y + x*z), 1 - 2*(x*x + y*y))
    return yaw, pitch, roll

def quat_to_euler_local_ZXY(q):
    """
    Intrinsic Z-X-Y (Yaw-Pitch-Roll)
    """
    w, x, y, z = q

    R = np.array([
        [1-2*(y*y+z*z), 2*(x*y-z*w),   2*(x*z+y*w)],
        [2*(x*y+z*w),   1-2*(x*x+z*z), 2*(y*z-x*w)],
        [2*(x*z-y*w),   2*(y*z+x*w),   1-2*(x*x+y*y)]
    ])

    pitch = np.arcsin(R[2,1])             # 绕局部 X
    yaw   = np.arctan2(-R[0,1], R[1,1])   # 绕局部 Z
    roll  = np.arctan2(-R[2,0], R[2,2])   # 绕局部 Y

    return yaw, pitch, roll


# ================= IMU 解算器 =================

class IMUTracker:
    def __init__(self, kp=0.01):
        self.q = np.array([1.0, 0.0, 0.0, 0.0])
        self.kp = kp
        self.g = 9.81

    def rk4_quat(self, q, omega):
        def q_dot(q, w):
            return 0.5 * quat_mul(q, np.array([0, *w]))

        k1 = q_dot(q, omega)
        k2 = q_dot(q + 0.5*k1, omega)
        k3 = q_dot(q + 0.5*k2, omega)
        k4 = q_dot(q + k3, omega)

        return normalize(q + (k1 + 2*k2 + 2*k3 + k4) / 6)

    def update(self, acc, dtheta):
        # ---------- Mahony 姿态修正 ----------
        acc_unit = normalize(acc)

        R = quat_to_rotmat(self.q)
        g_est = R.T @ np.array([0, 0, 1])

        error = np.cross(g_est, acc_unit)
        error[2] = 0.0   # 不允许修正 yaw
        omega = dtheta + self.kp * error

        # ---------- RK4 姿态更新 ----------
        self.q = self.rk4_quat(self.q, omega)

        return quat_to_euler_local_ZXY(self.q)




# uint32_t HAL_CRC_Calculate(CRC_HandleTypeDef *hcrc, uint32_t pBuffer[], uint32_t BufferLength)
def HAL_CRC_Calculate(buffer):
    POLYNOMIAL = 0x04C11DB7
    
    crc = 0xFFFFFFFF
    
    # 处理每个32位数据字
    for i in range(len(buffer)):
        # 将当前数据与CRC进行异或
        crc ^= buffer[i] & 0xFFFFFFFF
        
        # 处理32位
        for _ in range(32):
            # 检查最高位是否为1
            if crc & 0x80000000:
                # 如果最高位为1，左移并与多项式异或
                crc = ((crc << 1) & 0xFFFFFFFF) ^ POLYNOMIAL
            else:
                # 如果最高位为0，只左移
                crc = (crc << 1) & 0xFFFFFFFF
    
    return crc & 0xFFFFFFFF


