# avz_count = 0

yaw = 0.0
pitch = 0.0
roll = 0.0

to_degree_ratio = 45548
to_rad_ratio = to_degree_ratio * 180.0 / math.pi 
g = 9.81
to_mpersq_ratio = 2048 / g

imu = IMUTracker()

last_t = time.time()

while True:
    USBUartRxDataBufferLen = 38
    USB_uart_rx_data = target_serial.read(USBUartRxDataBufferLen)

    USB_uart_rx_data_0_crc = list(copy.copy(USB_uart_rx_data))
    for i in range(4):
        USB_uart_rx_data_0_crc[i+USBUartRxDataBufferLen-4] = 0
    USB_uart_rx_data_0_crc = bytearray(USB_uart_rx_data_0_crc)

    USB_uart_rx_data_uint32_block_num = len(USB_uart_rx_data) // 4
    if USB_uart_rx_data_uint32_block_num * 4 < len(USB_uart_rx_data) :
        USB_uart_rx_data_uint32_block_num += 1
    USB_uart_rx_data_0_crc = USB_uart_rx_data_0_crc[:(USB_uart_rx_data_uint32_block_num-1)*4]
    computed_crc32 = HAL_CRC_Calculate([struct.unpack('I', USB_uart_rx_data_0_crc[i*4:i*4+4])[0] for i in range(USB_uart_rx_data_uint32_block_num-1)])
    received_crc32 = struct.unpack('I', USB_uart_rx_data[USBUartRxDataBufferLen-4:USBUartRxDataBufferLen])[0]

    rectified_avx_multiply_8 = struct.unpack('i', USB_uart_rx_data[4:8])[0]
    rectified_avy_multiply_8 = struct.unpack('i', USB_uart_rx_data[8:12])[0]
    rectified_avz_multiply_8 = struct.unpack('i', USB_uart_rx_data[12:16])[0]
    received_ax = struct.unpack('h', USB_uart_rx_data[16:18])[0]
    received_ay = struct.unpack('h', USB_uart_rx_data[18:20])[0]
    received_az = struct.unpack('h', USB_uart_rx_data[20:22])[0]


    acc = np.array([received_ay/to_mpersq_ratio, -received_ax/to_mpersq_ratio, -received_az/to_mpersq_ratio])
    dtheta = np.array([-rectified_avy_multiply_8/to_rad_ratio, rectified_avx_multiply_8/to_rad_ratio, rectified_avz_multiply_8/to_rad_ratio])

    now_t = time.time()
    dt = now_t - last_t
    last_t = now_t
    euler = imu.update(acc, dtheta)

    yaw = math.degrees(euler[0])
    pitch = math.degrees(euler[1])
    roll = math.degrees(euler[2])
    received_yaw = struct.unpack('f', USB_uart_rx_data[22:26])[0]
    received_pitch = struct.unpack('f', USB_uart_rx_data[26:30])[0]
    received_roll = struct.unpack('f', USB_uart_rx_data[30:34])[0]

    print(f"{yaw:.2f} {pitch:.2f} {roll:.2f} {received_yaw:.2f} {received_pitch:.2f} {received_roll:.2f}")
    # print(f"{acc[0]:.2f} {acc[1]:.2f} {acc[2]:.2f}")
    # print(f"{pos[0]*1000:.2f} {pos[1]*1000:.2f} {pos[2]*1000:.2f}")


